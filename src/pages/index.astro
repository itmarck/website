---
// Static hosting can't read Accept-Language, so the browser picks: saved choice, then its own language.
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Marcelo Velásquez</title>
		<link rel="alternate" hreflang="en" href="/en/" />
		<link rel="alternate" hreflang="es" href="/es/" />
		<script is:inline>
			var saved = null
			try { saved = localStorage.getItem('lang') } catch (e) {}
			var es = (navigator.languages || [navigator.language]).some(function (l) { return /^es\b/i.test(l) })
			location.replace('/' + (saved || (es ? 'es' : 'en')) + '/')
		</script>
		<noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
	</head>
	<body style="background:#02040b"></body>
</html>
