---
import Footer from '../../components/Footer.astro'
import { copy, github, type Lang } from '../../i18n'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = () => Object.keys(copy).map((lang) => ({ params: { lang } }))

const t = copy[Astro.params.lang as Lang]
const p = t.projects
---

<Base t={t} path="projects/" title={p.title}>
	<div class="head rise"><h1>{p.title}</h1><p>{p.intro}</p></div>
	<main class="work">
		<!-- Minima: the card is the phone; below the text, the launcher's one field. What gets typed there is sent to Wingman (site.js). -->
		<article class="card c-minima rise" id="minima">
			<div class="card__foot">
				<div><span class="meta">{p.minima.status} · {p.minima.meta}</span><h2>Minima</h2><p>{p.minima.text}</p></div>
				<a class="pill" href={`${github}/minima`}>{p.open} <i aria-hidden="true">→</i></a>
			</div>
			<div class="screen" aria-hidden="true">
				<ul><li>Phone</li><li>Messages</li><li>Camera</li></ul>
				<div class="field"><span class="field__typed" data-typed></span><i class="field__caret"></i><span class="field__hint">What is on your mind?</span></div>
				<i class="screen__bar"></i>
			</div>
		</article>

		<!-- Wingman: the log Minima writes to; entries arrive and get their kind a moment later -->
		<article class="card c-wingman rise" id="wingman" style="--i:1">
			<div class="log" aria-hidden="true" data-log>
				<div><span>Review Minima release</span><b>task</b></div>
				<div><span>Ink shader: pause offscreen</span><b>note</b></div>
				<div><span>Website 2026</span><b>project</b></div>
			</div>
			<div class="card__foot">
				<div><span class="meta">{p.wingman.status} · {p.wingman.meta}</span><h2>Wingman</h2><p>{p.wingman.text}</p></div>
				<a class="pill pill--ghost" href={`${github}/wingman`}>GitHub <i aria-hidden="true">→</i></a>
			</div>
		</article>

				<article class="card c-tree rise" style="--i:2">
			<div class="card__foot">
				<div><span class="meta">{p.tree.status} · {p.tree.meta}</span><h2>Flutter Tree</h2><p>{p.tree.text}</p></div>
				<a class="pill" href="https://marketplace.visualstudio.com/items?itemName=marcelovelasquez.flutter-tree">{p.open} <i aria-hidden="true">→</i></a>
			</div>
		</article>

		<a class="card c-lapse rise" href={`${github}/bambulapse`}>
			<span class="meta">{p.lapse.meta}</span>
			<div><h2>Bambulapse</h2><p>{p.lapse.text}</p></div>
			<span class="go">GitHub <i aria-hidden="true">→</i></span>
		</a>

		<article class="card c-disney rise" style="--i:1">
			<span class="meta">{p.disney.meta}</span>
			<div><h2>{p.disney.title}</h2><p>{p.disney.text}</p></div>
		</article>

		<article class="card c-lab rise" style="--i:2">
			<span class="meta">{p.lab.meta}</span>
			<div><h2>{p.lab.title}</h2><p>{p.lab.text}</p></div>
		</article>
	</main>

	<section class="tile more rise">
		<header><h2>{p.more.title}</h2><a class="go" href={github}>{p.more.all} <i aria-hidden="true">→</i></a></header>
		<ul>
			{
				p.more.items.map((r) => (
					<li>
						<a href={`${github}/${r.name.toLowerCase()}`}>
							<b>{r.name}</b>
							<span class="more__text">{r.text}</span>
							<span class="meta">{r.meta}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
	<Footer t={t} />
</Base>

<style>
	/* named areas swapped per width (--work-*) */
	.work {
		display: grid;
		grid-template-columns: var(--work-cols);
		grid-template-rows: var(--work-rows);
		grid-template-areas: var(--work-areas);
		gap: var(--gap);
	}
	/* Cards over the ink: all slightly translucent except Minima, the one solid black card */
	.card {
		position: relative;
		border-radius: var(--radius);
		overflow: hidden;
		background-color: color-mix(in srgb, var(--surface) 86%, transparent);
		padding: 1.625rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.375rem;
		scroll-margin-top: var(--gap);
	}
	.card__foot .meta {
		margin-bottom: 0.5rem;
	}
	.card h2 {
		font-size: var(--step-m);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}
	.card p {
		color: var(--text-soft);
		max-width: 46ch;
		margin-top: 0.375rem;
	}
	.card__foot {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.meta {
		display: block;
		font-size: 0.8125rem;
		color: var(--text-soft);
	}
	.c-minima {
		grid-area: minima;
		background: #000;
		padding-bottom: 0.75rem;
	}
	/* white with transparency */
	.c-wingman {
		grid-area: wingman;
		background-color: rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 0 0 1px var(--edge);
	}
	.c-wingman p {
		color: var(--text);
	}
	/* a home color with transparency: the aqua tile */
	.c-tree {
		grid-area: tree;
		background-color: color-mix(in srgb, var(--tile-a) var(--tile-opacity), transparent);
		color: var(--text-on-color);
		justify-content: flex-end;
	}
	.c-tree p,
	.c-tree .meta {
		color: color-mix(in srgb, var(--text-on-color) 72%, transparent);
	}
	.c-tree .pill {
		background: var(--text-on-color);
		color: var(--text);
	}
	.c-tree .pill i {
		background: var(--text);
		color: var(--text-on-color);
	}
	.c-lab {
		grid-area: lab;
	}
	.c-lapse {
		grid-area: lapse;
		transition: background-color var(--dur-fast) var(--ease-hover);
	}
	.c-lapse:hover {
		background-color: color-mix(in srgb, var(--surface) 64%, transparent);
	}
	.c-disney {
		grid-area: disney;
		background-color: color-mix(in srgb, var(--surface-raised) 86%, transparent);
	}
	.c-disney p {
		color: #cfd3da;
	}

	/* Project fragments: drawn in HTML, in the site's language, and alive. Under reduced motion every
	   animation stops and the base styles (the finished state) show. */

	/* Minima: the launcher's bottom edge, in the card itself: a few apps as plain text, the field, the home bar */
	.screen {
		display: grid;
		gap: 2rem;
	}
	.screen ul {
		list-style: none;
		display: grid;
		gap: 0.625rem;
		padding: 0 0.25rem;
		font-size: 0.9375rem;
		color: var(--text-soft);
	}
	.field {
		display: flex;
		align-items: center;
		min-height: 3.25rem;
		padding: 0 1.125rem 0 0.875rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		white-space: nowrap;
	}
	/* a long entry ends in "…" instead of leaving the field */
	.field__typed {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--text);
	}
	.field__caret {
		flex: none;
		width: 2px;
		height: 1.1em;
		margin: 0 2px 0 1px;
		background: var(--tile-c);
		animation: blink 1.1s steps(1) infinite;
	}
	.field__hint {
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--text-soft);
	}
	.field__typed:not(:empty) ~ .field__hint {
		display: none;
	}
	.screen__bar {
		justify-self: center;
		width: 7.5rem;
		height: 0.3125rem;
		border-radius: 3px;
		background: var(--text);
		opacity: 0.6;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	/* Wingman: the rows, and one quiet chip color */
	.log {
		display: grid;
		gap: 0.5rem;
		align-self: stretch;
	}
	.log div {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		align-items: center;
		background: rgba(2, 4, 11, 0.72);
		border-radius: 0.75rem;
		padding: 0.625rem 0.625rem 0.625rem 0.875rem;
		font-size: 0.875rem;
		transition:
			opacity var(--dur) var(--ease),
			transform var(--dur) var(--ease);
	}
	.log b {
		font-size: 0.75rem;
		font-weight: 500;
		padding: 3px 0.625rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.14);
		box-shadow: inset 0 0 0 1px var(--hairline);
		transition: opacity var(--dur) var(--ease);
	}
	/* while site.js plays the sync, rows wait hidden until Minima sends them */
	.log.live div:not(.in) {
		opacity: 0;
		transform: translateY(0.625rem);
	}
	.log.live div:not(.labeled) b {
		opacity: 0;
	}

	/* More on GitHub */
	.more {
		background-color: color-mix(in srgb, var(--surface) 86%, transparent);
		margin-top: var(--gap);
		padding: 1.625rem;
	}
	.more header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.625rem;
	}
	.more h2 {
		white-space: nowrap;
		font-size: var(--step-m);
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.more ul {
		list-style: none;
	}
	.more li + li {
		box-shadow: inset 0 1px 0 var(--hairline);
	}
	.more li a {
		display: grid;
		grid-template-columns: var(--more-cols);
		grid-template-areas: var(--more-areas);
		gap: 0.25rem 1.5rem;
		align-items: baseline;
		padding: 1rem 0;
	}
	.more b {
		grid-area: name;
		font-weight: 700;
	}
	.more .meta {
		grid-area: meta;
	}
	.more__text {
		grid-area: text;
		color: var(--text-soft);
		transition: color var(--dur-fast) var(--ease-hover);
	}
	.more li a:hover .more__text {
		color: var(--text);
	}

</style>
