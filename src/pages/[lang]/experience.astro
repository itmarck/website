---
import { copy, type Lang } from '../../i18n'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = () => Object.keys(copy).map((lang) => ({ params: { lang } }))

const t = copy[Astro.params.lang as Lang]
const x = t.experience
---

<Base t={t} path="experience/" title={x.title} description={x.description}>
	<div class="cv">
		<aside class="tile profile rise">
			<header>
				<h2>Marcelo Velásquez</h2>
				<!-- contact is also in the menu, so here it only needs a quiet corner icon -->
				<button class="write" type="button" popovertarget="contact" aria-label={x.cta} title={x.cta}>
					<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m4 7 8 6 8-6"></path></svg>
				</button>
			</header>
			<p class="summary">{x.summary}</p>
			<dl class="facts">{x.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
			<section class="stack">
				<h3>{x.skills.title}</h3>
				<dl>{x.skills.groups.map((g) => <div><dt>{g.name}</dt><dd>{g.items.split(' · ').map((tool) => <Fragment><span>{tool}</span>{' '}</Fragment>)}</dd></div>)}</dl>
			</section>
		</aside>

		<main>
			<div class="head rise" style="--i:1"><h1>{x.title}</h1><p>{x.intro}</p></div>
			<ol class="timeline">
				<span class="line" aria-hidden="true"></span>
				{
					x.jobs.map((job, i) => (
						<li class="rise" style={`--i:${i}`}>
							<span class:list={['node', { now: i === 0 }]} aria-hidden="true" />
							<article class:list={['tile job', { now: i === 0 }]}>
								<header>
									<div>
										<h2>{job.company}</h2>
										{job.client && <p class="soft">{job.client}</p>}
									</div>
									<span class="when">{job.when}</span>
								</header>
								<ul>
									{job.items.map((item) => <li><h3>{item.title}</h3><p class="soft">{item.text}</p></li>)}
								</ul>
							</article>
						</li>
					))
				}
			</ol>
		</main>
	</div>
</Base>

<style>
	.cv {
		display: grid;
		grid-template-columns: var(--cv-cols);
		gap: var(--gap);
		align-items: start;
	}
	.soft {
		color: var(--text-soft);
	}
	.cv .head {
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		padding-top: 1.75rem;
	}
	/* the title follows its column, not the window, so a wider profile never pushes it out */
	.cv main {
		container-type: inline-size;
	}
	.cv .head h1 {
		font-size: min(var(--step-xl), 17cqi);
	}
	.cv .head p {
		text-align: left;
		max-width: 44ch;
	}

	/* cards over the ink are slightly translucent, like on the other pages */
	.profile,
	.job {
		background-color: color-mix(in srgb, var(--surface) 86%, transparent);
	}
	.profile {
		position: var(--profile-position);
		order: var(--profile-order);
		top: var(--sticky-top, var(--gap));
		padding: clamp(1.75rem, 3vw, 2.25rem) clamp(1.5rem, 3vw, 2rem);
		display: grid;
		gap: 1.5rem;
		justify-items: start;
	}
	.profile header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		width: 100%;
	}
	.profile h2 {
		font-size: var(--step-m);
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.write {
		flex: none;
		width: 2.75rem;
		height: 2.75rem;
		margin: -0.375rem -0.5rem 0 0;
		border-radius: 50%;
		display: grid;
		place-items: center;
		color: var(--text);
		background: rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 0 0 1px var(--hairline);
		transition:
			background-color var(--dur-fast) var(--ease-hover),
			color var(--dur-fast) var(--ease-hover);
	}
	.write:hover {
		background-color: var(--text);
		color: var(--text-on-color);
	}
	.write svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.summary {
		color: var(--text-soft);
		line-height: 1.6;
		margin-top: -0.75rem;
	}

	/* facts: the highlight, as three figures side by side (value large, label under it), split by
	   thin dividers so every column starts at the same edge */
	.facts {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		width: 100%;
		padding: 1.375rem 0;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--tile-a) var(--tile-opacity), transparent);
		color: var(--text-on-color);
		container-type: inline-size;
	}
	.facts div {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: 0.375rem;
		padding: 0 clamp(0.375rem, 2.5cqi, 1.25rem);
	}
	.facts div + div {
		box-shadow: inset 1px 0 0 color-mix(in srgb, var(--text-on-color) 18%, transparent);
	}
	.facts dt {
		font-size: 0.8125rem;
		color: color-mix(in srgb, var(--text-on-color) 72%, transparent);
	}
	.facts dd {
		font-size: var(--step-m);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	/* stack: the detail, as a quiet two-column list on the card itself */
	.stack {
		width: 100%;
		container-type: inline-size;
	}
	.stack dl div {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 0.25rem 1rem;
		align-items: baseline;
		padding: 0.75rem 0;
	}
	.stack dl div + div {
		box-shadow: inset 0 1px 0 var(--hairline);
	}
	.stack dt {
		font-size: var(--step-xs);
	}
	.stack h3 {
		font-size: var(--step-xs);
		font-weight: 500;
		margin-bottom: 0.25rem;
	}
	.stack dt {
		color: var(--text-soft);
	}
	@container (width < 22rem) {
		.stack dl div {
			grid-template-columns: 1fr;
		}
	}
	.stack dd {
		line-height: 1.5;
	}
	/* wrap between tools, never inside one or before its separator */
	.stack dd span {
		white-space: nowrap;
	}
	.stack dd span:not(:last-child)::after {
		content: ' ·';
	}

	.timeline {
		position: relative;
		list-style: none;
		display: grid;
		gap: var(--gap);
		padding-left: 2rem;
	}
	/* one continuous gradient through every job, fading out toward the oldest */
	.line {
		position: absolute;
		left: 0.5625rem;
		top: 0.75rem;
		bottom: 0.75rem;
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(
			var(--tile-c),
			var(--tile-b) 45%,
			color-mix(in srgb, var(--tile-a) 70%, transparent) 75%,
			color-mix(in srgb, var(--tile-a) 10%, transparent)
		);
	}
	.timeline > li {
		position: relative;
	}
	.node {
		position: absolute;
		left: -1.875rem;
		top: 1.875rem;
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		background: var(--ink-0);
		box-shadow: inset 0 0 0 2px var(--text);
	}
	.node.now {
		background: var(--tile-c);
		box-shadow: 0 0 0 6px color-mix(in srgb, var(--tile-c) 25%, transparent);
	}
	/* "now" breathes: a lime ring widens and fades */
	.node.now::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		box-shadow: 0 0 0 2px var(--tile-c);
		animation: ping 2.4s var(--ease) infinite;
	}
	@keyframes ping {
		from {
			opacity: 0.8;
		}
		to {
			opacity: 0;
			transform: scale(2.6);
		}
	}
	.job {
		padding: 1.5rem clamp(1.5rem, 3vw, 2rem);
	}
	/* the current job: white with transparency, the one card that stands apart */
	.job.now {
		background-color: rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 0 0 1px var(--edge);
	}
	.job.now .soft {
		color: var(--text);
	}
	.job header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.625rem 1rem;
	}
	.job h2 {
		font-size: var(--step-m);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}
	.job header p {
		margin-top: 0.25rem;
	}
	.when {
		flex: none;
		font-size: var(--step-xs);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		padding: 0.375rem 0.75rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.14);
		box-shadow: inset 0 0 0 1px var(--hairline);
	}
	.job ul {
		list-style: none;
		display: grid;
		gap: 1.125rem;
		margin-top: 1.5rem;
	}
	.job ul li {
		padding-left: 1rem;
		border-left: 2px solid var(--hairline);
	}
	.job h3 {
		font-size: var(--step-s);
		font-weight: 700;
	}
	.job ul p {
		margin-top: 0.25rem;
		max-width: 60ch;
	}

</style>
