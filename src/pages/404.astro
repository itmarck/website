---
import Base from '../layouts/Base.astro'
import { copy } from '../i18n'
---

<Base t={copy.en}>
	<main>
		<h1>{copy.en.notFound.title}</h1>
		<p lang="es">{copy.es.notFound.title}</p>
		<a class="pill" href="/">{copy.en.notFound.back} · {copy.es.notFound.back} <i aria-hidden="true">→</i></a>
	</main>
</Base>

<style>
	main {
		min-height: 100svh;
		display: grid;
		place-content: center;
		justify-items: start;
		gap: 16px;
		padding: var(--pad);
	}
	h1 {
		font-size: var(--step-l);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: 1;
	}
	p {
		color: var(--text-soft);
		margin-bottom: 16px;
	}
</style>
