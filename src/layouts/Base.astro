---
import { ClientRouter } from 'astro:transitions'
import '../styles/theme.css'
import { type Copy, email, github, linkedin, socialCard, website } from '../i18n'

interface Props {
  t: Copy
  path?: '' | 'projects/' | 'experience/'
  title?: string
  description?: string
}
const { t, path = '', title, description = t.description } = Astro.props
const site = Astro.site?.href ?? '/'
const other = t.switchTo.href.slice(1, 3)
const pageTitle = title ? `${title} — ${t.title}` : t.title
const canonical = Astro.url.pathname.startsWith('/404')
  ? undefined
  : new URL(Astro.url.pathname, site).href
const nav = [
  { href: `/${t.lang}/projects/`, label: t.nav.projects, current: path === 'projects/' },
  { href: `/${t.lang}/experience/`, label: t.nav.experience, current: path === 'experience/' },
]
---

<!doctype html>
<html lang={t.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#02040b" />
		<!-- the itmarck mark: a hexagon split into two pieces along a slash, read as </> (see README) -->
		<link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{canonical && <link rel="canonical" href={canonical} />}
		{
			Astro.params.lang && (
				<Fragment>
					<link rel="alternate" hreflang="en" href={`${site}en/${path}`} />
					<link rel="alternate" hreflang="es" href={`${site}es/${path}`} />
					{!path && <link rel="alternate" hreflang="x-default" href={site} />}
				</Fragment>
			)
		}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={website.name} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialCard.url} />
		<meta property="og:image:width" content={socialCard.width} />
		<meta property="og:image:height" content={socialCard.height} />
		<meta property="og:locale" content={t.locale.replace('-', '_')} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
		<script is:inline>document.documentElement.classList.add('js')</script>
		<ClientRouter />
		<slot name="head" />
	</head>
	<body>
		<canvas id="ink" aria-hidden="true" transition:persist></canvas>

		<aside class="rail">
			<a class="mark" href={`/${t.lang}/`} aria-label={t.nav.home}>
				<svg viewBox="0 0 64 64" aria-hidden="true">
					<g fill="currentColor" stroke="currentColor" stroke-width="4" stroke-linejoin="round">
						<path d="M31.44 12.27 L15.33 12.27 L3.83 32 L15.33 51.73 L22.24 51.73 Z"></path>
						<path d="M41.76 14.67 L48.67 14.67 L60.17 34.4 L48.67 54.13 L32.56 54.13 Z"></path>
					</g>
				</svg>
			</a>
			<nav>
				{nav.map((l) => <a href={l.href} class:list={{ current: l.current }} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
				<button type="button" popovertarget="contact">{t.nav.contact}</button>
			</nav>
			<a class="lang" href={`/${other}/${path}`} hreflang={other} data-lang={other} lang={other}>{other.toUpperCase()}<span class="sr">{t.switchTo.label}</span></a>
		</aside>

		<div id="contact" class="contact" popover aria-labelledby="contact-title">
			<button class="contact__close" type="button" popovertarget="contact" popovertargetaction="hide" aria-label={t.reach.close}>×</button>
			<h2 id="contact-title">{t.modal.title}</h2>
			<p class="contact__text">{t.modal.text}</p>
			<div class="contact__mail">
				<span>{email}</span>
				<button class="chip" type="button" data-copy={email} data-done={t.about.copied}>{t.about.copy}</button>
			</div>
			<a class="pill contact__go" href={`mailto:${email}`}>{t.reach.mail} <i aria-hidden="true">→</i></a>
			<p class="contact__also">{t.modal.also}</p>
			<ul class="contact__links">
				<li><a href={github}><b>GitHub</b><span>itmarck</span><i aria-hidden="true">↗</i></a></li>
				<li><a href={linkedin}><b>LinkedIn</b><span>marceloovelasquez</span><i aria-hidden="true">↗</i></a></li>
			</ul>
		</div>

		<div class="app" tabindex="-1">
			<div class="page"><slot /></div>
		</div>

		<script>
			import '../scripts/site.js'
		</script>
	</body>
</html>

<style>
	#ink {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}
	/* left column, or bottom bar on small screens (--rail-*) */
	.rail {
		position: fixed;
		inset: var(--rail-inset);
		width: var(--rail-width);
		height: var(--rail-height);
		transform: var(--rail-shift);
		z-index: 3;
		display: flex;
		flex-direction: var(--rail-dir);
		align-items: center;
		justify-content: space-between;
		gap: clamp(0.25rem, 5vw - 0.75rem, 0.875rem);
		padding: var(--rail-padding);
		border-radius: 999px;
		background: var(--rail-bg);
		backdrop-filter: var(--rail-blur);
		box-shadow: var(--rail-edge);
	}
	/* the mark and the language switch sit quietly, like the menu items: dimmed, full on hover */
	.mark,
	.lang {
		width: clamp(1.75rem, 10vw - 0.25rem, 2.5rem);
		height: 2.5rem;
		display: grid;
		place-items: center;
		color: var(--text);
		opacity: 0.72;
		transition: opacity var(--dur-fast) var(--ease-hover);
	}
	.mark:hover,
	.lang:hover {
		opacity: 1;
	}
	.mark svg {
		width: 1.875rem;
		height: 1.875rem;
	}
	.lang {
		font-size: var(--step-xs);
		font-weight: 500;
	}
	.rail nav {
		display: flex;
		flex-direction: var(--rail-dir);
		gap: var(--rail-nav-gap);
	}
	.rail nav > * {
		writing-mode: var(--rail-writing);
		transform: var(--rail-turn);
		font-size: var(--step-xs);
		font-weight: 500;
		opacity: 0.72;
		transition: opacity var(--dur-fast) var(--ease-hover);
	}
	.rail nav > :hover,
	.rail nav .current {
		opacity: 1;
	}

	/* contact: centered popover over a strong blur with a faint ink tint (site.js pauses the ink meanwhile) */
	.contact {
		position: fixed;
		inset: 0;
		margin: auto;
		width: min(30rem, 100vw - 1.5rem);
		height: fit-content;
		max-height: calc(100svh - 1.5rem);
		overflow: auto;
		padding: clamp(1.75rem, 6vw, 2.25rem) clamp(1.375rem, 6vw, 2.25rem);
		border: 0;
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--surface) 86%, transparent);
		color: var(--text);
		box-shadow:
			inset 0 0 0 1px var(--edge),
			inset 0 1px 0 rgba(255, 255, 255, 0.1),
			0 30px 80px rgba(2, 4, 11, 0.45);
		opacity: 0;
		transform: translateY(1rem) scale(0.97);
		transition:
			opacity var(--dur-fast) var(--ease-hover),
			transform var(--dur) var(--ease),
			display var(--dur-fast) allow-discrete,
			overlay var(--dur-fast) allow-discrete;
	}
	.contact::backdrop {
		background: color-mix(in srgb, var(--ink-0) 20%, transparent);
		backdrop-filter: blur(28px);
		opacity: 0;
		transition:
			opacity var(--dur) var(--ease),
			display var(--dur) allow-discrete,
			overlay var(--dur) allow-discrete;
	}
	.contact:popover-open,
	.contact:popover-open::backdrop {
		opacity: 1;
		transform: none;
	}
	@starting-style {
		.contact:popover-open,
		.contact:popover-open::backdrop {
			opacity: 0;
		}
		.contact:popover-open {
			transform: translateY(1rem) scale(0.97);
		}
	}
	.contact h2 {
		font-size: var(--step-l);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: 0.95;
	}
	.contact__text {
		margin-top: 0.875rem;
		color: var(--text-soft);
		line-height: 1.6;
		max-width: 36ch;
	}
	.contact__mail {
		margin-top: 1.75rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 0.75rem 0.75rem 1.25rem;
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.06);
		box-shadow: inset 0 0 0 1px var(--hairline);
		font-weight: 500;
		overflow-wrap: anywhere;
	}
	.contact__go {
		margin-top: 0.75rem;
		width: 100%;
		justify-content: space-between;
	}
	.contact__also {
		margin-top: 1.75rem;
		font-size: var(--step-xs);
		color: var(--text-soft);
	}
	.contact__links {
		list-style: none;
		margin-top: 0.5rem;
	}
	.contact__links a {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: 0.75rem;
		padding: 0.875rem 0;
		box-shadow: inset 0 -1px 0 var(--hairline);
	}
	.contact__links li:last-child a {
		box-shadow: none;
	}
	.contact__links span {
		font-size: var(--step-xs);
		color: var(--text-soft);
		transition: color var(--dur-fast) var(--ease-hover);
	}
	.contact__links i {
		font-style: normal;
		color: var(--text-soft);
		transition: color var(--dur-fast) var(--ease-hover);
	}
	.contact__links a:hover i,
	.contact__links a:hover span {
		color: var(--text);
	}
	.contact__close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		font-size: 1.5rem;
		line-height: 1;
		color: var(--text-soft);
		transition:
			color var(--dur-fast) var(--ease-hover),
			background var(--dur-fast) var(--ease-hover);
	}
	.contact__close:hover {
		color: var(--text);
		background: var(--surface-glass);
	}

	.app {
		position: relative;
		z-index: 1;
		padding: var(--gap) calc(var(--side) + var(--gap)) var(--app-bottom) calc(var(--side) + max(var(--rail), var(--gap)));
	}
	/* cards enter from 2.5rem below; clip that transient overflow so a page that fits
	   doesn't flash a scrollbar during the entrance */
	.page {
		overflow-y: clip;
	}
	/* Except on touch screens, the page scrolls inside .app instead of the window: a window scrollbar sits
	   outside anything the ink can paint, an element's scrollbar floats over the ink. Its space is
	   always reserved, so content never jumps. Touch devices keep native page scrolling. */
	@media not (pointer: coarse) {
		:global(html),
		:global(body) {
			height: 100%;
			overflow: hidden;
		}
		.app {
			height: 100%;
			overflow-y: auto;
			scrollbar-gutter: stable;
			scroll-behavior: smooth;
			/* sticky offsets already start below this scroller's top padding */
			--sticky-top: 0px;
		}
		.app:focus {
			outline: none;
		}
	}

</style>
