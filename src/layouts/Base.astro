---
import { ClientRouter } from 'astro:transitions'
import '../styles/theme.css'
import { email, github, linkedin, type Copy } from '../i18n'

interface Props {
	t: Copy
	path?: '' | 'projects/' | 'experience/'
	title?: string
}
const { t, path = '', title } = Astro.props
const site = Astro.site?.href ?? '/'
const other = t.switchTo.href.slice(1, 3)
const nav = [
	{ href: `/${t.lang}/projects/`, label: t.nav.projects, current: path === 'projects/' },
	{ href: `/${t.lang}/experience/`, label: t.nav.experience, current: path === 'experience/' },
]
---

<!doctype html>
<html lang={t.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title ? `${title} — ${t.title}` : t.title}</title>
		<meta name="description" content={t.description} />
		<meta name="theme-color" content="#02040b" />
		<link rel="icon" href="/favicon/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon/icon.svg" type="image/svg+xml" />
		<link rel="alternate" hreflang="en" href={`${site}en/${path}`} />
		<link rel="alternate" hreflang="es" href={`${site}es/${path}`} />
		<link rel="alternate" hreflang="x-default" href={site} />
		<meta property="og:title" content={t.title} />
		<meta property="og:description" content={t.description} />
		<meta property="og:image" content={site + 'social-card.png'} />
		<meta property="og:locale" content={t.locale.replace('-', '_')} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
		<script is:inline>document.documentElement.classList.add('js')</script>
		<ClientRouter />
	</head>
	<body>
		<canvas id="ink" aria-hidden="true" transition:persist></canvas>

		<aside class="rail">
			<a class="mark" href={`/${t.lang}/`} aria-label={t.nav.home}>it</a>
			<nav>
				{nav.map((l) => <a href={l.href} class:list={{ current: l.current }} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
				<button type="button" popovertarget="contact">{t.nav.contact}</button>
			</nav>
			<a class="lang" href={`/${other}/${path}`} hreflang={other} data-lang={other} lang={other}>{other.toUpperCase()}<span class="sr">{t.switchTo.label}</span></a>
		</aside>

		<div id="contact" class="contact" popover aria-labelledby="contact-title">
			<button class="contact__close" type="button" popovertarget="contact" popovertargetaction="hide" aria-label={t.reach.close}>×</button>
			<h2 id="contact-title">{t.modal.title}</h2>
			<p class="contact__text">{t.modal.text}</p>
			<div class="contact__mail">
				<span>{email}</span>
				<button class="chip" type="button" data-copy={email} data-done={t.about.copied}>{t.about.copy}</button>
			</div>
			<a class="pill contact__go" href={`mailto:${email}`}>{t.reach.mail} <i aria-hidden="true">→</i></a>
			<p class="contact__also">{t.modal.also}</p>
			<ul class="contact__links">
				<li><a href={github}><b>GitHub</b><span>itmarck</span><i aria-hidden="true">↗</i></a></li>
				<li><a href={linkedin}><b>LinkedIn</b><span>marceloovelasquez</span><i aria-hidden="true">↗</i></a></li>
			</ul>
		</div>

		<div class="app">
			<slot />
		</div>

		<script>
			import '../scripts/site.js'
		</script>
	</body>
</html>

<style>
	#ink {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}
	.rail {
		position: fixed;
		left: 0;
		top: 0;
		bottom: 0;
		width: 72px;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		padding: 22px 0;
	}
	.mark,
	.lang {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-weight: 800;
		font-size: 15px;
		letter-spacing: -0.04em;
	}
	.mark {
		background: var(--text);
		color: var(--text-on-color);
	}
	.lang {
		box-shadow: inset 0 0 0 1.5px var(--text);
		font-size: 13px;
		transition:
			background var(--dur-fast) var(--ease),
			color var(--dur-fast) var(--ease);
	}
	.lang:hover {
		background: var(--text);
		color: var(--text-on-color);
	}
	.rail nav {
		display: flex;
		flex-direction: column;
		gap: 34px;
	}
	.rail nav > * {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		font-size: var(--step-xs);
		font-weight: 500;
		opacity: 0.72;
		transition: opacity var(--dur-fast) var(--ease);
	}
	.rail nav > :hover,
	.rail nav .current,
	.rail nav button[aria-expanded='true'] {
		opacity: 1;
	}

	/* contact: centered popover over a strong blur with a faint ink tint (site.js pauses the ink meanwhile) */
	.contact {
		position: fixed;
		inset: 0;
		margin: auto;
		width: min(480px, calc(100vw - 24px));
		height: fit-content;
		max-height: calc(100svh - 24px);
		overflow: auto;
		padding: 36px;
		border: 0;
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--surface) 86%, transparent);
		color: var(--text);
		box-shadow:
			inset 0 0 0 1px var(--edge),
			inset 0 1px 0 rgba(255, 255, 255, 0.1),
			0 30px 80px rgba(2, 4, 11, 0.45);
		opacity: 0;
		transform: translateY(16px) scale(0.97);
		transition:
			opacity var(--dur-fast) var(--ease),
			transform var(--dur) var(--ease),
			display var(--dur-fast) allow-discrete,
			overlay var(--dur-fast) allow-discrete;
	}
	.contact::backdrop {
		background: color-mix(in srgb, var(--ink-0) 20%, transparent);
		backdrop-filter: blur(28px);
		opacity: 0;
		transition:
			opacity var(--dur) var(--ease),
			display var(--dur) allow-discrete,
			overlay var(--dur) allow-discrete;
	}
	.contact:popover-open,
	.contact:popover-open::backdrop {
		opacity: 1;
		transform: none;
	}
	@starting-style {
		.contact:popover-open,
		.contact:popover-open::backdrop {
			opacity: 0;
		}
		.contact:popover-open {
			transform: translateY(16px) scale(0.97);
		}
	}
	.contact h2 {
		font-size: var(--step-l);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: 0.95;
	}
	.contact__text {
		margin-top: 14px;
		color: var(--text-soft);
		line-height: 1.6;
		max-width: 36ch;
	}
	.contact__mail {
		margin-top: 28px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 12px 12px 12px 20px;
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.06);
		box-shadow: inset 0 0 0 1px var(--hairline);
		font-weight: 500;
		overflow-wrap: anywhere;
	}
	.contact__go {
		margin-top: 12px;
		width: 100%;
		justify-content: space-between;
	}
	.contact__also {
		margin-top: 28px;
		font-size: var(--step-xs);
		color: var(--text-soft);
	}
	.contact__links {
		list-style: none;
		margin-top: 8px;
	}
	.contact__links a {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: 12px;
		padding: 14px 0;
		box-shadow: inset 0 -1px 0 var(--hairline);
	}
	.contact__links li:last-child a {
		box-shadow: none;
	}
	.contact__links span {
		font-size: var(--step-xs);
		color: var(--text-soft);
	}
	.contact__links i {
		font-style: normal;
		transition: transform var(--dur) var(--ease);
	}
	.contact__links a:hover i {
		transform: translate(2px, -2px);
	}
	.contact__close {
		position: absolute;
		top: 16px;
		right: 16px;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		font-size: 24px;
		line-height: 1;
		color: var(--text-soft);
		transition:
			color var(--dur-fast) var(--ease),
			background var(--dur-fast) var(--ease);
	}
	.contact__close:hover {
		color: var(--text);
		background: var(--surface-glass);
	}

	.app {
		position: relative;
		z-index: 1;
		padding: var(--gap) var(--gap) var(--gap) var(--rail);
	}

	@media (max-width: 900px) {
		.app {
			padding: 10px 10px 96px;
		}
		.rail {
			inset: auto auto 14px 50%;
			width: auto;
			height: 56px;
			transform: translateX(-50%);
			flex-direction: row;
			padding: 0 8px;
			gap: 14px;
			border-radius: 999px;
			background: rgba(10, 12, 17, 0.72);
			backdrop-filter: blur(16px);
			box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
		}
		.rail nav {
			flex-direction: row;
			gap: 16px;
		}
		.rail nav > * {
			writing-mode: horizontal-tb;
			transform: none;
		}
		.contact {
			padding: 28px 22px;
		}
	}
</style>
